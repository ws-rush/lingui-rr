{
  "name": "lingui-rr",
  "version": "6.12.0-1",
  "description": "React Router v8 framework-mode integration for Lingui.",
  "type": "module",
  "license": "MIT",
  "author": "ws-rush",
  "homepage": "https://github.com/ws-rush/lingui-rr#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ws-rush/lingui-rr.git"
  },
  "bugs": {
    "url": "https://github.com/ws-rush/lingui-rr/issues"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run --dir tests",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:e2e": "pnpm build && pnpm --filter @lingui-rr/e2e test",
    "test:all": "pnpm test && pnpm test:e2e",
    "fallow": "fallow audit",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . --ignore-path .gitignore --deny-warnings --type-aware --tsconfig tsconfig.lint.json",
    "lint:fix": "oxlint . --ignore-path .gitignore --fix --type-aware --tsconfig tsconfig.lint.json",
    "format:check": "oxfmt . --check --ignore-path .gitignore",
    "format": "oxfmt . --write --ignore-path .gitignore",
    "build": "rm -rf dist && vite build",
    "release": "bumpp",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "react-router",
    "lingui",
    "i18n",
    "internationalization",
    "localization",
    "react"
  ],
  "peerDependencies": {
    "@lingui/core": "^6.0.0",
    "@lingui/react": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.0.0"
  },
  "devDependencies": {
    "@lingui/core": "^6.12.0",
    "@lingui/react": "^6.12.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "5.1.0",
    "bumpp": "^12.3.0",
    "fallow": "^3.43.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.0",
    "vue": "^3.5.45"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@10.10.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
